# Server Runtime
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=https://app.yourdomain.example
API_PUBLIC_URL=https://api.yourdomain.example
SMOKE_API_URL=https://api.yourdomain.example/api/v1

# Database (MongoDB Atlas SRV Connection String - Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/rozgaar?retryWrites=true&w=majority

# Authentication & JWT Secrets (Required, min 32 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_here
ACCESS_TOKEN_TTL=15m
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_here
REFRESH_TOKEN_TTL=7d
JWT_REFRESH_EXPIRY_DAYS=7

# Storage Configuration ('local' or 's3')
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 Configuration (Required if STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_s3_bucket_name
AWS_S3_BUCKET=your_s3_bucket_name

# Mail Configuration (Optional - falls back to Ethereal mock in dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Rozgaar <noreply@yourdomain.example>"

# Database Seeding Permissions
SEED_ALLOW=false
SEED_DEMO_PASSWORD=your_seed_demo_password_here
